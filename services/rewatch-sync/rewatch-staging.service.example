[Unit]
Description=Nuvio isolated rewatch sync STAGING (loopback only)
After=network.target

[Service]
Type=simple
User=nuvio-rewatch
Group=nuvio-rewatch
WorkingDirectory=/opt/nuvio-rewatch-staging/services/rewatch-sync
Environment=REWATCH_BIND=127.0.0.1
Environment=REWATCH_PORT=8765
Environment=REWATCH_DB_PATH=/var/lib/nuvio-rewatch-staging/rewatches.json
Environment=REWATCH_CREDENTIALS_FILE=/etc/nuvio-rewatch-staging/credentials.json
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nuvio-rewatch-staging
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
